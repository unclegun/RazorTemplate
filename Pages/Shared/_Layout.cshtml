<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RazorTemplate</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="container container--wide">
            <nav class="site-nav" aria-label="Main" data-nav>
                <a class="site-nav__brand" asp-area="" asp-page="/Index">RazorTemplate</a>
                <button class="button button--secondary site-nav__toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav-menu">Menu</button>
                <ul id="site-nav-menu" class="site-nav__menu" data-nav-menu>
                    <li><a class="site-nav__link" asp-area="" asp-page="/Index">Home</a></li>
                    <li><a class="site-nav__link" asp-area="" asp-page="/Privacy">Privacy</a></li>
                    <li><a class="site-nav__link" asp-area="" asp-page="/DesignSystem/Index">Design system</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="main-content" class="site-main-content">
        <div class="container container--wide">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            &copy; 2026 - RazorTemplate - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script type="module" src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
